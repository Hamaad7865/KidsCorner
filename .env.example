# Kids Corner — environment template.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API (or Project Settings -> API Keys on newer projects)

# e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public, RLS-guarded client key. Newer projects call this the
# "publishable" key (sb_publishable_...); older ones the "anon" key (a JWT).
# Either works — set whichever your dashboard shows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service_role / secret key in a NEXT_PUBLIC_ variable: anything
# with that prefix is inlined into the browser bundle. Nothing in this app
# needs it — every write goes through RLS or a SECURITY DEFINER RPC.
