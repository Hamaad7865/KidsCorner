<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A debug-only window onto each screen, with invented data.

      It exists because the real screens sit behind a PIN, an open shift and a
      completed sale, and checking that a layout matches the handoff should not
      require ringing up a sale against the live shop. This source set is not
      part of a release build, so the activity cannot ship.
    -->
    <application>
        <activity
            android:name=".debug.GalleryActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale"
            android:theme="@style/Theme.KidsCornerTill" />
    </application>

</manifest>
