<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Installing the till's own updates. A per-app, user-granted toggle since
      API 26 (Settings > "Install unknown apps"), checked at runtime before
      the install intent fires — AppUpdater.canInstall() — rather than assumed
      granted. Declaring it is what lets the till ask at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      AppUpdater downloads the update quietly (VISIBILITY_HIDDEN) rather than
      through the system's own download notification. Without this permission
      DownloadManager.enqueue() doesn't just ignore that setting — it throws
      SecurityException("Invalid value for visibility: 2") the moment a real
      update is available to fetch, crashing the app on its very next
      heartbeat. Found live: the till reached this the first time it actually
      had something to download.
    -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!--
      Receipt printing over Bluetooth.

      BLUETOOTH_CONNECT is runtime-granted from API 31; the two legacy
      permissions are capped below it so a modern device is not asked for
      permissions it no longer uses.

      `neverForLocation` is deliberate: scanning for nearby devices can be used
      to infer where a device is, and Android therefore ties it to location
      permission unless the app declares it will not do that. A till has no
      business knowing where it is.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Not required: a shop may run a network printer, or none at all. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- USB host, for a printer wired to the tablet. Not required: a tablet
         without an OTG port simply cannot offer USB, and the settings screen
         says so rather than the app refusing to install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      A shop tablet, not a phone. Landscape only, because the sell screen puts
      the cart beside the products and a rotation mid-sale would reflow the
      basket under a cashier's hand.
    -->
    <application
        android:name=".TillApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsCornerTill">

        <!--
          stateAlwaysHidden: the till's search box takes focus by itself so a
          hardware scanner can keep typing into it, and Android answers focus
          with its own automatic keyboard. The soft hide that races it loses on
          real hardware, so the window simply never opens with the IME up —
          tapping the field still brings the keyboard out deliberately.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:theme="@style/Theme.KidsCornerTill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands the downloaded update APK to Android's installer as a
          content:// URI. Required since Nougat: a file:// URI crossing the
          boundary into the system installer throws FileUriExposedException.
          Scoped to the app's own downloads directory only — see
          res/xml/file_paths.xml — so nothing else this app writes is exposed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
