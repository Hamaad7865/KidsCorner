<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Receipt printing over Bluetooth.

      BLUETOOTH_CONNECT is runtime-granted from API 31; the two legacy
      permissions are capped below it so a modern device is not asked for
      permissions it no longer uses.

      `neverForLocation` is deliberate: scanning for nearby devices can be used
      to infer where a device is, and Android therefore ties it to location
      permission unless the app declares it will not do that. A till has no
      business knowing where it is.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Not required: a shop may run a network printer, or none at all. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- USB host, for a printer wired to the tablet. Not required: a tablet
         without an OTG port simply cannot offer USB, and the settings screen
         says so rather than the app refusing to install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      A shop tablet, not a phone. Landscape only, because the sell screen puts
      the cart beside the products and a rotation mid-sale would reflow the
      basket under a cashier's hand.
    -->
    <application
        android:name=".TillApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsCornerTill">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale"
            android:launchMode="singleTask"
            android:theme="@style/Theme.KidsCornerTill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
