<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: the shop's mark (see kc_mark.xml, same paths) scaled from
  its native 128 box into the 72dp safe zone of the 108dp adaptive canvas, so
  no launcher mask — circle, squircle, teardrop — can clip a kangaroo ear.

  72/128 = 0.5625, then nudged in by 18 on both axes to centre it. The group
  scale carries the strokes with it, which is why the widths below are still
  the artwork's own numbers.

  It replaced a hand-drawn receipt with a torn foot. That icon was fine and had
  nothing to do with Kids Corner; this is the same picture the browser tab, the
  PIN screen and the top of the till all show.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="safe_zone"
        android:scaleX="0.5625"
        android:scaleY="0.5625"
        android:translateX="18"
        android:translateY="18">

        <path
            android:pathData="M105,37 C94,23 73,25 66,43 C57,66 67,98 91,103 C98,104 105,101 110,97"
            android:strokeColor="#3F2E3D"
            android:strokeWidth="25"
            android:strokeLineCap="round" />
        <path
            android:pathData="M105,37 C94,23 73,25 66,43 C57,66 67,98 91,103 C98,104 105,101 110,97"
            android:strokeColor="#A71937"
            android:strokeWidth="17"
            android:strokeLineCap="round" />

        <group
            android:name="ear_left"
            android:pivotX="27"
            android:pivotY="23"
            android:rotation="-18">
            <path
                android:pathData="M20,23 a7,15 0 1,0 14,0 a7,15 0 1,0 -14,0 z"
                android:fillColor="#ECA65B"
                android:strokeColor="#3F2E3D"
                android:strokeWidth="4" />
        </group>
        <group
            android:name="ear_right"
            android:pivotX="43"
            android:pivotY="22"
            android:rotation="18">
            <path
                android:pathData="M36,22 a7,15 0 1,0 14,0 a7,15 0 1,0 -14,0 z"
                android:fillColor="#ECA65B"
                android:strokeColor="#3F2E3D"
                android:strokeWidth="4" />
        </group>
        <path
            android:pathData="M35,35 L35,98 M37,66 L66,38 M38,66 L70,99"
            android:strokeColor="#3F2E3D"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M35,35 L35,98 M37,66 L66,38 M38,66 L70,99"
            android:strokeColor="#ECA65B"
            android:strokeWidth="15"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M28.5,39 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z"
            android:fillColor="#3F2E3D" />
        <path
            android:pathData="M22,47 Q15,52 19,59"
            android:strokeColor="#3F2E3D"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
        <path
            android:pathData="M22,47 Q15,52 19,59"
            android:strokeColor="#ECA65B"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
    </group>
</vector>
