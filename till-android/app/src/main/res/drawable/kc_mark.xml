<?xml version="1.0" encoding="utf-8"?>
<!--
  The shop's own mark, from kids-corner-brand-assets/kids-corner-favicon.svg.

  A "KC" monogram where the K is a kangaroo and the C is drawn as one stroke.
  Every coordinate below is the SVG's, unchanged, so a future edit to the
  artwork can be diffed against the source rather than re-traced. Only the
  shapes SVG has and Android does not — <ellipse> and <circle> — are rewritten
  as arc paths; the transforms become <group rotation>.

  The till used to draw the letters "KC" in a rounded coral square instead.
  That was never the shop's logo, and it is the one place a customer looks
  across the counter and expects to see the shop they are standing in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- the C: a plum outline with the brand red laid inside it -->
    <path
        android:pathData="M105,37 C94,23 73,25 66,43 C57,66 67,98 91,103 C98,104 105,101 110,97"
        android:strokeColor="#3F2E3D"
        android:strokeWidth="25"
        android:strokeLineCap="round" />
    <path
        android:pathData="M105,37 C94,23 73,25 66,43 C57,66 67,98 91,103 C98,104 105,101 110,97"
        android:strokeColor="#A71937"
        android:strokeWidth="17"
        android:strokeLineCap="round" />

    <!-- the K, as a kangaroo: two ears, the body, an eye and a forepaw -->
    <group
        android:name="ear_left"
        android:pivotX="27"
        android:pivotY="23"
        android:rotation="-18">
        <path
            android:pathData="M20,23 a7,15 0 1,0 14,0 a7,15 0 1,0 -14,0 z"
            android:fillColor="#ECA65B"
            android:strokeColor="#3F2E3D"
            android:strokeWidth="4" />
    </group>
    <group
        android:name="ear_right"
        android:pivotX="43"
        android:pivotY="22"
        android:rotation="18">
        <path
            android:pathData="M36,22 a7,15 0 1,0 14,0 a7,15 0 1,0 -14,0 z"
            android:fillColor="#ECA65B"
            android:strokeColor="#3F2E3D"
            android:strokeWidth="4" />
    </group>
    <path
        android:pathData="M35,35 L35,98 M37,66 L66,38 M38,66 L70,99"
        android:strokeColor="#3F2E3D"
        android:strokeWidth="24"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M35,35 L35,98 M37,66 L66,38 M38,66 L70,99"
        android:strokeColor="#ECA65B"
        android:strokeWidth="15"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M28.5,39 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z"
        android:fillColor="#3F2E3D" />
    <path
        android:pathData="M22,47 Q15,52 19,59"
        android:strokeColor="#3F2E3D"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M22,47 Q15,52 19,59"
        android:strokeColor="#ECA65B"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
