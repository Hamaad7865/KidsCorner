<resources>
    <!--
      Only the values Android itself needs before Compose is running: the
      launcher tile and the splash window. Everything drawn after that comes
      from Color.kt / Handoff.kt, so a colour is not defined twice.
    -->
    <!-- #A71936 — the red inside kids-corner-favicon.svg; the web's brand-600. -->
    <color name="brand_600">#A71936</color>
    <!-- The page, and the splash before the first frame. White, like the app. -->
    <color name="brand_white">#FFFFFF</color>
</resources>
