<resources>
    <!--
      Only the splash/window theme. Everything drawn after Compose starts comes
      from Theme.kt, so colours live in one place rather than two.

      The window is white so the splash is the same white the till opens onto —
      it used to flash a pale coral for the frame before the first draw, which
      read as a colour change every time the app was launched.

      The bar colours are set but rarely seen: MainActivity hides the system
      bars outright. They matter for the moment before that call lands, and if
      a shop ever runs the till without immersive mode.
    -->
    <style name="Theme.KidsCornerTill" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_white</item>
        <item name="android:statusBarColor">@color/brand_600</item>
        <item name="android:navigationBarColor">@color/brand_600</item>
    </style>
</resources>
