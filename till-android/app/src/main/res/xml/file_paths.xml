<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes the FileProvider to exactly the directory AppUpdater downloads into
  — this app's own external-files "Download" subdirectory — and nothing else.
  Matches Environment.DIRECTORY_DOWNLOADS under getExternalFilesDir(), which
  needs no storage permission because it is private to this app.
-->
<paths>
    <external-files-path name="till-downloads" path="Download/" />
</paths>
